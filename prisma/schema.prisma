generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                   @id @default(cuid())
  email                 String                   @unique
  name                  String
  role                  String
  passwordHash          String
  createdAt             DateTime                 @default(now())
  sessions              Session[]
  comments              OrderComment[]
  notifications         Notification[]
  uploadedFiles         StoredFile[]
  createdOrders         PurchaseOrder[]          @relation("OrderCreator")
  assignedOrders        PurchaseOrder[]          @relation("AssignedEngineer")
  paymentRecords        PaymentRecord[]
  materialRequests      MaterialRequest[]        @relation("MaterialRequestsCreated")
  directExpenses        DirectExpenseRequest[]   @relation("DirectExpensesCreated")
  solicitudAttachments  SolicitudAttachment[]
  directExpenseFiles    DirectExpenseFile[]
  directExpensePayments DirectExpensePayment[]
  recurringCommitments  RecurringCommitment[]
  invoiceFirstCommitments InvoiceFirstCommitment[] @relation("InvoiceFirstCreated")
  invoiceFirstFiles       InvoiceFirstFile[]
  recurringCommitmentFiles RecurringCommitmentFile[]
  expedientes              Expediente[]
  obraMemberships          ObraMember[]
  createdObras             Obra[]                  @relation("ObraCreator")
  viaticos                 Viatico[]               @relation("ViaticosCreated")
  viaticoExpenses          ViaticoExpense[]        @relation("ViaticoExpensesCreated")
  viaticoExpenseFiles      ViaticoExpenseFile[]
  companyCardMovementsCreated     CompanyCardMovement[] @relation("CompanyCardMovementsCreated")
  companyCardMovementsResponsible CompanyCardMovement[] @relation("CompanyCardMovementResponsible")
  companyCardMovementFiles        CompanyCardMovementFile[]
  vehiclesCreated                 Vehicle[]                 @relation("VehiclesCreated")
  vehiclesResponsible             Vehicle[]                 @relation("VehicleResponsible")
  fuelLoadsCreated                FuelLoad[]
  fuelLoadFiles                   FuelLoadFile[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Supplier {
  id              String          @id @default(cuid())
  legalName       String
  rfc             String
  commercialName  String          @default("")
  taxRegime       String          @default("")
  phone           String          @default("")
  email           String          @default("")
  website         String          @default("")
  street          String          @default("")
  neighborhood    String          @default("")
  zipCode         String          @default("")
  city            String          @default("")
  state           String          @default("")
  country         String          @default("México")
  primaryContact  String          @default("")
  notes           String          @default("")
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  orders          PurchaseOrder[]
  recurringCommitments RecurringCommitment[]
  invoiceFirstCommitments InvoiceFirstCommitment[]
}

model Obra {
  id               String          @id @default(cuid())
  name             String
  code             String          @default("")
  client           String          @default("")
  managerName      String          @default("")
  startDate        DateTime?
  estimatedEndDate DateTime?
  maxMaterialsBudget Float           @default(0)
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())
  createdByUserId  String?
  createdBy        User?           @relation("ObraCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  members          ObraMember[]
  orders           PurchaseOrder[]
  materialRequests MaterialRequest[]
  directExpenses   DirectExpenseRequest[]
  recurringCommitments RecurringCommitment[]
  invoiceFirstCommitments InvoiceFirstCommitment[]
  expedientes          Expediente[]
  viaticos             Viatico[]
  companyCardMovements CompanyCardMovement[]
  vehicles             Vehicle[]
  fuelLoads            FuelLoad[]
}

// Ingenieros designados en la obra (equipo). Se define al crear/editar la obra, no en la OC.
model ObraMember {
  id        String   @id @default(cuid())
  obraId    String
  obra      Obra     @relation(fields: [obraId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([obraId, userId])
  @@index([userId])
}

model PurchaseOrder {
  id                     String          @id @default(cuid())
  obraId                 String
  obra                   Obra            @relation(fields: [obraId], references: [id], onDelete: Cascade)
  title                  String
  description            String          @default("")
  supplierName           String
  supplierId             String?
  supplier               Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  ocFolio                String          @default("")
  ocDate                 DateTime?
  paymentTerms           String          @default("")
  internalReference      String          @default("")
  documentDate           DateTime?
  assignedEngineerUserId String?
  assignedEngineer       User?           @relation("AssignedEngineer", fields: [assignedEngineerUserId], references: [id], onDelete: SetNull)
  totalAmount            Float
  amountPaidSoFar        Float           @default(0)
  currency               String          @default("MXN")
  /// Tipo de cambio Banxico FIX (pesos por dólar) al registrar OC en USD.
  fxRate                 Float?
  /// Fecha del FIX Banxico usado.
  fxRateDate             DateTime?
  /// Total convertido a MXN (igual a totalAmount si currency=MXN).
  totalAmountMxn         Float?
  /// Nota legible: TC del día, origen Banxico.
  fxNote                 String          @default("")
  paymentLabel           String          @default("pendiente")
  paymentType            String?
  suggestedPaymentType   String?
  paymentDueDate         DateTime?
  status                 String          @default("draft")
  /// Variante de flujo: a = OC con Ingeniería; c = OC a Administración (sin Ingeniería).
  processKind            String          @default("a")
  createdByUserId        String
  createdBy              User            @relation("OrderCreator", fields: [createdByUserId], references: [id])
  sentToEngineerAt       DateTime?
  materialRequestId      String?         @unique
  materialRequest        MaterialRequest? @relation(fields: [materialRequestId], references: [id], onDelete: SetNull)
  invoiceFirstCommitmentId String?       @unique
  invoiceFirstCommitment InvoiceFirstCommitment? @relation(fields: [invoiceFirstCommitmentId], references: [id], onDelete: SetNull)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  comments               OrderComment[]
  files                  StoredFile[]
  notifications          Notification[]
  paymentRecords         PaymentRecord[]
  expedienteId           String?
  expediente             Expediente?     @relation(fields: [expedienteId], references: [id], onDelete: SetNull)
}

model PaymentRecord {
  id               String        @id @default(cuid())
  orderId          String
  order            PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount           Float
  reference        String        @default("")
  notes            String        @default("")
  recordedByUserId String
  recordedBy       User          @relation(fields: [recordedByUserId], references: [id])
  createdAt        DateTime      @default(now())
}

model OrderComment {
  id        String        @id @default(cuid())
  orderId   String
  order     PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id])
  body      String
  kind      String
  createdAt DateTime      @default(now())
}

model StoredFile {
  id               String        @id @default(cuid())
  orderId          String
  order            PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind             String
  originalFileName String
  storagePath      String
  // PDF en BD cuando FILES_STORAGE=database o en Vercel (demo).
  fileData         Bytes?
  mimeType         String        @default("application/pdf")
  sizeBytes        Int
  uploadedByUserId String
  uploadedBy       User          @relation(fields: [uploadedByUserId], references: [id])
  createdAt        DateTime      @default(now())
}

model Notification {
  id                        String                  @id @default(cuid())
  userId                    String
  user                      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId                   String?
  order                     PurchaseOrder?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  directExpenseId           String?
  directExpense             DirectExpenseRequest?   @relation(fields: [directExpenseId], references: [id], onDelete: SetNull)
  invoiceFirstCommitmentId  String?
  invoiceFirstCommitment    InvoiceFirstCommitment? @relation(fields: [invoiceFirstCommitmentId], references: [id], onDelete: SetNull)
  recurringCommitmentId     String?
  recurringCommitment       RecurringCommitment?    @relation(fields: [recurringCommitmentId], references: [id], onDelete: SetNull)
  materialRequestId         String?
  materialRequest           MaterialRequest?        @relation(fields: [materialRequestId], references: [id], onDelete: SetNull)
  type                      String
  message                   String
  read                      Boolean                 @default(false)
  requiresAcknowledgement   Boolean                 @default(false)
  acknowledged              Boolean                 @default(false)
  createdAt                 DateTime                @default(now())
}

// Proceso A — Solicitud de material (Ingeniería inicia).
model MaterialRequest {
  id                String                @id @default(cuid())
  obraId            String
  obra              Obra                  @relation(fields: [obraId], references: [id], onDelete: Cascade)
  costCenter        String                @default("")
  materials         String                @default("")
  quantities        String                @default("")
  justification     String                @default("")
  status            String                @default("draft")
  createdByUserId   String
  createdBy         User                  @relation("MaterialRequestsCreated", fields: [createdByUserId], references: [id])
  sentAt            DateTime?
  purchaseOrder     PurchaseOrder?
  notifications     Notification[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  attachments       SolicitudAttachment[]
}

// Proceso B — Gasto directo sin OC (Ingeniería / solicitante inicia).
model DirectExpenseRequest {
  id                String                 @id @default(cuid())
  obraId            String
  obra              Obra                   @relation(fields: [obraId], references: [id], onDelete: Cascade)
  costCenter        String                 @default("")
  category          String                 @default("")
  supplierName      String                 @default("")
  estimatedAmount   Float                  @default(0)
  currency          String                 @default("MXN")
  justification     String                 @default("")
  status            String                 @default("draft")
  amountPaidSoFar   Float                  @default(0)
  paymentLabel      String                 @default("pendiente")
  createdByUserId   String
  createdBy         User                   @relation("DirectExpensesCreated", fields: [createdByUserId], references: [id])
  sentAt            DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  attachments       SolicitudAttachment[]
  files             DirectExpenseFile[]
  paymentRecords    DirectExpensePayment[]
  notifications     Notification[]
}

model DirectExpensePayment {
  id               String               @id @default(cuid())
  expenseId        String
  expense          DirectExpenseRequest @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  amount           Float
  reference        String               @default("")
  notes            String               @default("")
  recordedByUserId String
  recordedBy       User                 @relation(fields: [recordedByUserId], references: [id])
  createdAt        DateTime             @default(now())
}

model DirectExpenseFile {
  id               String               @id @default(cuid())
  expenseId        String
  expense          DirectExpenseRequest @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  kind             String
  originalFileName String
  storagePath      String               @default("")
  fileData         Bytes?
  mimeType         String               @default("application/pdf")
  sizeBytes        Int
  uploadedByUserId String
  uploadedBy       User                 @relation(fields: [uploadedByUserId], references: [id])
  createdAt        DateTime             @default(now())
}

model SolicitudAttachment {
  id                String                @id @default(cuid())
  materialRequestId String?
  materialRequest   MaterialRequest?      @relation(fields: [materialRequestId], references: [id], onDelete: Cascade)
  directExpenseId   String?
  directExpense     DirectExpenseRequest? @relation(fields: [directExpenseId], references: [id], onDelete: Cascade)
  originalFileName  String
  storagePath       String                @default("")
  fileData          Bytes?
  mimeType          String                @default("application/pdf")
  sizeBytes         Int
  uploadedByUserId  String
  uploadedBy        User                  @relation(fields: [uploadedByUserId], references: [id])
  createdAt         DateTime              @default(now())
}

// Proceso C — Factura primero (Dirección inicia; luego OC y flujo A).
model InvoiceFirstCommitment {
  id              String             @id @default(cuid())
  invoiceFolio    String             @default("")
  supplierId      String?
  supplier        Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierName    String
  obraId          String?
  obra            Obra?              @relation(fields: [obraId], references: [id], onDelete: SetNull)
  totalAmount     Float
  currency        String             @default("MXN")
  invoiceDate     DateTime
  comment         String             @default("")
  status          String             @default("awaiting_oc")
  createdByUserId String
  createdBy       User               @relation("InvoiceFirstCreated", fields: [createdByUserId], references: [id])
  ocRequestedAt   DateTime?
  purchaseOrder   PurchaseOrder?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  files           InvoiceFirstFile[]
  notifications   Notification[]
  expedienteId    String?
  expediente      Expediente? @relation(fields: [expedienteId], references: [id], onDelete: SetNull)
}

model InvoiceFirstFile {
  id               String               @id @default(cuid())
  commitmentId     String
  commitment       InvoiceFirstCommitment @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  kind             String
  originalFileName String
  storagePath      String               @default("")
  fileData         Bytes?
  mimeType         String               @default("application/pdf")
  sizeBytes        Int
  uploadedByUserId String
  uploadedBy       User                 @relation(fields: [uploadedByUserId], references: [id])
  createdAt        DateTime             @default(now())
}

model RecurringCommitment {
  id                   String                    @id @default(cuid())
  supplierId           String?
  supplier             Supplier?                 @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierName         String
  concept              String
  frequency            String
  expectedReceptionDay Int
  nextReceptionDate    DateTime
  dueDate              DateTime
  obraId               String?
  obra                 Obra?                     @relation(fields: [obraId], references: [id], onDelete: SetNull)
  costCenter           String                    @default("")
  currency             String                    @default("MXN")
  estimatedAmount      Float?
  amount               Float                     @default(0)
  occurredOn           DateTime
  category             String                    @default("otro")
  paymentMethod        String                    @default("")
  seriesId             String
  occurrenceKey        String
  lifecycleStatus      String                    @default("active")
  workflowStatus       String                    @default("pending")
  notes                String                    @default("")
  active               Boolean                   @default(true)
  createdByUserId      String
  createdBy            User                      @relation(fields: [createdByUserId], references: [id])
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  files                RecurringCommitmentFile[]
  notifications        Notification[]

  @@unique([seriesId, occurrenceKey])
  @@index([seriesId])
  @@index([occurredOn])
  @@index([category])
}

model Expediente {
  id              String   @id @default(cuid())
  folio           String   @unique
  name            String
  notes           String   @default("")
  obraId          String?
  obra            Obra?    @relation(fields: [obraId], references: [id], onDelete: SetNull)
  createdByUserId String
  createdBy       User     @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  purchaseOrders           PurchaseOrder[]
  invoiceFirstCommitments  InvoiceFirstCommitment[]
}

// Viáticos: dinero entregado a un empleado en una obra, con un comprobante por gasto.
model Employee {
  id        String    @id @default(cuid())
  firstName String
  lastName  String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  viaticos  Viatico[]
  companyCardMovements CompanyCardMovement[]

  @@index([active])
}

model Viatico {
  id               String           @id @default(cuid())
  employeeId       String
  employee         Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  obraId           String
  obra             Obra             @relation(fields: [obraId], references: [id], onDelete: Restrict)
  deliveredAmount  Float
  createdByUserId  String
  createdBy        User             @relation("ViaticosCreated", fields: [createdByUserId], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  expenses         ViaticoExpense[]

  @@index([employeeId])
  @@index([obraId])
  @@index([createdAt])
}

model ViaticoExpense {
  id                   String               @id @default(cuid())
  viaticoId            String
  viatico              Viatico              @relation(fields: [viaticoId], references: [id], onDelete: Cascade)
  concept              String
  amount               Float
  receiptKind          String
  missingReceiptReason String               @default("")
  createdByUserId      String
  createdBy            User                 @relation("ViaticoExpensesCreated", fields: [createdByUserId], references: [id])
  createdAt            DateTime             @default(now())
  files                ViaticoExpenseFile[]

  @@index([viaticoId])
}

model ViaticoExpenseFile {
  id               String         @id @default(cuid())
  expenseId        String
  expense          ViaticoExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  kind             String
  originalFileName String
  storagePath      String         @default("")
  fileData         Bytes?
  mimeType         String         @default("application/pdf")
  sizeBytes        Int
  uploadedByUserId String
  uploadedBy       User           @relation(fields: [uploadedByUserId], references: [id])
  createdAt        DateTime       @default(now())

  @@index([expenseId])
}

// Tarjetas empresariales: mismos gastos para débito y crédito. La carga de saldo solo aplica a débito.
model CompanyCard {
  id        String                @id
  bank      String
  kind      String
  label     String
  slot      Int
  lastFour  String                @default("")
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  movements CompanyCardMovement[]
  fuelLoads FuelLoad[]

  @@unique([bank, kind, slot])
}

model CompanyCardMovement {
  id                    String                     @id @default(cuid())
  cardId                String
  card                  CompanyCard                @relation(fields: [cardId], references: [id], onDelete: Restrict)
  kind                  String
  occurredOn            DateTime
  amount                Float
  supplierName          String                     @default("")
  concept               String
  category              String                     @default("")
  destinationKind       String                     @default("")
  obraId                String?
  obra                  Obra?                      @relation(fields: [obraId], references: [id], onDelete: SetNull)
  costCenter            String                     @default("")
  responsibleUserId     String?
  responsibleUser       User?                      @relation("CompanyCardMovementResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  responsibleEmployeeId String?
  responsibleEmployee   Employee?                  @relation(fields: [responsibleEmployeeId], references: [id], onDelete: SetNull)
  receiptKind           String                     @default("")
  missingReceiptReason  String                     @default("")
  status                String                     @default("")
  createdByUserId       String
  createdBy             User                       @relation("CompanyCardMovementsCreated", fields: [createdByUserId], references: [id])
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  files                 CompanyCardMovementFile[]

  @@index([cardId])
  @@index([occurredOn])
  @@index([kind])
}

model CompanyCardMovementFile {
  id               String              @id @default(cuid())
  movementId       String
  movement         CompanyCardMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  kind             String
  originalFileName String
  storagePath      String              @default("")
  fileData         Bytes?
  mimeType         String              @default("application/pdf")
  sizeBytes        Int
  uploadedByUserId String
  uploadedBy       User                @relation(fields: [uploadedByUserId], references: [id])
  createdAt        DateTime            @default(now())

  @@index([movementId])
}

// Flotilla y combustible. El comprobante de la carga se borra a los 3 meses; el gasto permanece.
model Vehicle {
  id                 String               @id @default(cuid())
  code               String               @default("")
  name               String
  year               Int?
  plates             String               @default("")
  vehicleType        String               @default("")
  color              String               @default("")
  vin                String               @default("")
  engineNumber       String               @default("")
  ownerName          String               @default("Consorcio Constructor Profesional")
  status             String               @default("activo")
  currentKm          Float                @default(0)
  responsibleUserId  String?
  responsibleUser    User?                @relation("VehicleResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  obraId             String?
  obra               Obra?                @relation(fields: [obraId], references: [id], onDelete: SetNull)
  notes              String               @default("")
  imageData          Bytes?
  imageMime          String               @default("")
  createdByUserId    String
  createdBy          User                 @relation("VehiclesCreated", fields: [createdByUserId], references: [id])
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  documents          VehicleDocument[]
  maintenances       VehicleMaintenance[]
  financing          VehicleFinancing?
  expenses           VehicleExpense[]
  fuelLoads          FuelLoad[]

  @@index([status])
}

model VehicleDocument {
  id        String    @id @default(cuid())
  vehicleId String
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  kind      String
  name      String
  expiresOn DateTime?
  createdAt DateTime  @default(now())

  @@index([vehicleId])
  @@index([expiresOn])
}

model VehicleMaintenance {
  id          String    @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  title       String
  dueOn       DateTime?
  dueKm       Float?
  completedOn DateTime?
  notes       String    @default("")
  createdAt   DateTime  @default(now())

  @@index([vehicleId])
}

model VehicleFinancing {
  id             String                    @id @default(cuid())
  vehicleId      String                    @unique
  vehicle        Vehicle                   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  kind           String
  institution    String
  termMonths     Int
  monthlyPayment Float
  balance        Float
  nextPaymentOn  DateTime?
  notes          String                    @default("")
  payments       VehicleFinancingPayment[]
}

model VehicleFinancingPayment {
  id          String           @id @default(cuid())
  financingId String
  financing   VehicleFinancing @relation(fields: [financingId], references: [id], onDelete: Cascade)
  paidOn      DateTime
  amount      Float
  notes       String           @default("")
  createdAt   DateTime         @default(now())

  @@index([financingId])
}

model VehicleExpense {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  occurredOn  DateTime
  concept     String
  amount      Float
  notes       String   @default("")
  createdAt   DateTime @default(now())

  @@index([vehicleId])
}

model FuelLoad {
  id              String         @id @default(cuid())
  vehicleId       String
  vehicle         Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  occurredOn      DateTime
  odometerKm      Float
  liters          Float
  amount          Float
  pricePerLiter   Float
  kmPerLiter      Float?
  stationName     String
  companyCardId   String
  companyCard     CompanyCard    @relation(fields: [companyCardId], references: [id], onDelete: Restrict)
  destinationKind String
  obraId          String?
  obra            Obra?          @relation(fields: [obraId], references: [id], onDelete: SetNull)
  costCenter      String         @default("")
  receiptKind     String
  notes           String         @default("")
  createdByUserId String
  createdBy       User           @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  files           FuelLoadFile[]

  @@index([vehicleId, occurredOn])
  @@index([companyCardId])
  @@index([occurredOn])
}

model FuelLoadFile {
  id               String    @id @default(cuid())
  fuelLoadId       String
  fuelLoad         FuelLoad  @relation(fields: [fuelLoadId], references: [id], onDelete: Cascade)
  kind             String
  originalFileName String
  storagePath      String    @default("")
  fileData         Bytes?
  mimeType         String    @default("application/pdf")
  sizeBytes        Int
  expiresAt        DateTime
  purgedAt         DateTime?
  uploadedByUserId String
  uploadedBy       User      @relation(fields: [uploadedByUserId], references: [id])
  createdAt        DateTime  @default(now())

  @@index([fuelLoadId])
  @@index([expiresAt])
}

model RecurringCommitmentFile {
  id               String              @id @default(cuid())
  commitmentId     String
  commitment       RecurringCommitment @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  kind             String
  originalFileName String
  storagePath      String              @default("")
  fileData         Bytes?
  mimeType         String              @default("application/pdf")
  sizeBytes        Int
  uploadedByUserId String
  uploadedBy       User                @relation(fields: [uploadedByUserId], references: [id])
  createdAt        DateTime            @default(now())
}
