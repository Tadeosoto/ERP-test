generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String          @id @default(cuid())
  email            String          @unique
  name             String
  role             String
  passwordHash     String
  createdAt        DateTime        @default(now())
  sessions         Session[]
  comments         OrderComment[]
  notifications    Notification[]
  uploadedFiles    StoredFile[]
  createdOrders       PurchaseOrder[] @relation("OrderCreator")
  assignedOrders      PurchaseOrder[] @relation("AssignedEngineer")
  paymentRecords      PaymentRecord[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Supplier {
  id              String          @id @default(cuid())
  legalName       String
  rfc             String
  commercialName  String          @default("")
  taxRegime       String          @default("")
  phone           String          @default("")
  email           String          @default("")
  website         String          @default("")
  street          String          @default("")
  neighborhood    String          @default("")
  zipCode         String          @default("")
  city            String          @default("")
  state           String          @default("")
  country         String          @default("México")
  primaryContact  String          @default("")
  notes           String          @default("")
  createdAt       DateTime        @default(now())
  orders          PurchaseOrder[]
}

model Obra {
  id               String          @id @default(cuid())
  name             String
  code             String          @default("")
  client           String          @default("")
  managerName      String          @default("")
  startDate        DateTime?
  estimatedEndDate DateTime?
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())
  orders           PurchaseOrder[]
}

model PurchaseOrder {
  id                     String          @id @default(cuid())
  obraId                 String
  obra                   Obra            @relation(fields: [obraId], references: [id], onDelete: Cascade)
  title                  String
  description            String          @default("")
  supplierName           String
  supplierId             String?
  supplier               Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  ocFolio                String          @default("")
  ocDate                 DateTime?
  paymentTerms           String          @default("")
  internalReference      String          @default("")
  documentDate           DateTime?
  assignedEngineerUserId String?
  assignedEngineer       User?           @relation("AssignedEngineer", fields: [assignedEngineerUserId], references: [id], onDelete: SetNull)
  totalAmount            Float
  amountPaidSoFar        Float           @default(0)
  currency               String          @default("MXN")
  paymentLabel           String          @default("pendiente")
  paymentType            String?
  suggestedPaymentType   String?
  paymentDueDate         DateTime?
  status                 String          @default("draft")
  createdByUserId        String
  createdBy              User            @relation("OrderCreator", fields: [createdByUserId], references: [id])
  sentToEngineerAt       DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  comments               OrderComment[]
  files                  StoredFile[]
  notifications          Notification[]
  paymentRecords         PaymentRecord[]
}

model PaymentRecord {
  id               String        @id @default(cuid())
  orderId          String
  order            PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount           Float
  reference        String        @default("")
  notes            String        @default("")
  recordedByUserId String
  recordedBy       User          @relation(fields: [recordedByUserId], references: [id])
  createdAt        DateTime      @default(now())
}

model OrderComment {
  id        String        @id @default(cuid())
  orderId   String
  order     PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id])
  body      String
  kind      String
  createdAt DateTime      @default(now())
}

model StoredFile {
  id               String        @id @default(cuid())
  orderId          String
  order            PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind             String
  originalFileName String
  storagePath      String
  // PDF en BD cuando FILES_STORAGE=database o en Vercel (demo).
  fileData         Bytes?
  mimeType         String        @default("application/pdf")
  sizeBytes        Int
  uploadedByUserId String
  uploadedBy       User          @relation(fields: [uploadedByUserId], references: [id])
  createdAt        DateTime      @default(now())
}

model Notification {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  order     PurchaseOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type      String
  message   String
  read      Boolean        @default(false)
  createdAt DateTime       @default(now())
}
